{
  "name": "referencecheck",
  "version": "0.1.4",
  "description": "Reference-integrity checks for academic papers: DOI validation, retraction detection, predatory-journal screening, reference deduplication, citation-count lookup, and open-access / preprint / expression-of-concern / citation-replies detection.",
  "license": "MIT",
  "author": "Gilad Feldman",
  "repository": {
    "type": "git",
    "url": "https://github.com/giladfeldman/referencecheck.git"
  },
  "homepage": "https://github.com/giladfeldman/referencecheck#readme",
  "bugs": {
    "url": "https://github.com/giladfeldman/referencecheck/issues"
  },
  "keywords": [
    "reference-checking",
    "doi-validation",
    "retraction",
    "predatory-journal",
    "deduplication",
    "open-access",
    "preprint",
    "meta-science",
    "academic-integrity",
    "open-science"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && npm run copy-data",
    "prepare": "npm run build",
    "copy-data": "node scripts/copy-data.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "fastest-levenshtein": "^1.0.16"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0",
    "rimraf": "^5.0.0"
  }
}
